{
  "manifest_version": 3,
  "name": "RamGuard — Reliable Tab Suspender",
  "short_name": "RamGuard",
  "description": "Reliable MV3 tab suspender that frees Chrome RAM using native tab discarding without killing active work, media, or pinned tabs.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RamGuard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ]
}
